{
  "name": "ai-support-engine",
  "version": "1.0.0",
  "description": "Clasificación inteligente de solicitudes de soporte con un motor basado en reglas y un motor de IA generativa (Ollama).",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test",
    "benchmark": "node --env-file-if-exists=.env benchmark/run-benchmark.js",
    "evidence": "node benchmark/capture-api-evidence.js",
    "train": "python ml/train.py"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "zod": "^4.6.7"
  }
}
