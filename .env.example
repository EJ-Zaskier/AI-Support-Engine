# Copia este archivo como .env y ajusta los valores.
# .env está en .gitignore: NUNCA subas credenciales al repositorio.

PORT=3000

# Proveedor del motor generativo: "ollama" (local, sin API key) u "openai-compatible"
LLM_PROVIDER=ollama

# --- Ollama (local) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Proveedor compatible con OpenAI (Groq, OpenAI, Gemini, LM Studio...) ---
# Solo se usa si LLM_PROVIDER=openai-compatible
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.1-8b-instant
# OPENAI_API_KEY=pon_tu_api_key_aqui

# Tiempo máximo de espera de la respuesta del modelo (ms)
LLM_TIMEOUT_MS=60000

# Límite de peticiones por minuto por IP a /api/analyze
RATE_LIMIT_PER_MINUTE=60
